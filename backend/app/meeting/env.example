# Meeting module. Copy values into the process environment.
# Do not commit real secrets.

MOCK_ASR=1
MOCK_LLM=1
MOCK_FEISHU=1
MEETING_REVIEW_TOKEN_TTL_SECONDS=3600

# Optional HMAC secret. If unset, the process mints an ephemeral secret.
# MEETING_REVIEW_TOKEN_SECRET=

# Used only when MOCK_FEISHU=0. Leave empty in git.
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_API_BASE=https://open.feishu.cn
